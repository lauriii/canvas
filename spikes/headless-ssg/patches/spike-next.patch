+    status: boolean;
+    drupal_internal__id?: number;
+    drupal_internal__nid?: number;
+    path?: { alias?: string | null } | null;
+  };
+}
+
+async function listPublishedPaths(): Promise<string[]> {
+  const baseUrl = process.env.CANVAS_SITE_URL!.replace(/\/$/, '');
+  const paths: string[] = ['/'];
+  const collections: Array<[string, (a: JsonApiEntity['attributes']) => string]> = [
+    [
+      'canvas_page/canvas_page',
+      (a) => a.path?.alias || `/page/${a.drupal_internal__id}`,
+    ],
+    ['node/article', (a) => a.path?.alias || `/node/${a.drupal_internal__nid}`],
+  ];
+  for (const [collection, toPath] of collections) {
+    const response = await fetch(`${baseUrl}/jsonapi/${collection}`, {
+      headers: { Accept: 'application/vnd.api+json' },
+    });
+    if (!response.ok) {
+      throw new Error(`JSON:API ${collection} failed: ${response.status}`);
+    }
+    const document = (await response.json()) as { data?: JsonApiEntity[] };
+    for (const entity of document.data ?? []) {
+      // filter[status]=1 silently returns empty for canvas_page, so filter
+      // client-side.
+      if (entity.attributes.status) {
+        paths.push(toPath(entity.attributes));
+      }
+    }
+  }
+  return paths;
+}
+
+export async function generateStaticParams(): Promise<{ slug: string[] }[]> {
+  const paths = await listPublishedPaths();
+  return paths.map((path) => ({
+    slug: path.split('/').filter(Boolean),
+  }));
 }
 

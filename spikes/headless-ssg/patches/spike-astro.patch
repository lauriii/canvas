+++ spike-astro/src/lib/static-paths.ts	2026-08-27 17:31:11
@@ -0,0 +1,61 @@
+/**
+ * ponytail: build-time page enumeration via anonymous JSON:API. Follows
+ * links.next pagination; covers canvas_page + article. A real solution
+ * needs a Canvas-provided route inventory (see HEADLESS-SSG-RESEARCH.md).
+ */
+const SITE = process.env.CANVAS_SITE_URL ?? '';
+
+interface JsonApiItem {
+  attributes: {
+    path?: { alias?: string | null } | null;
+    drupal_internal__id?: number;
+    drupal_internal__nid?: number;
+    status?: boolean;
+  };
+}
+
+async function collect(url: string): Promise<JsonApiItem[]> {
+  const items: JsonApiItem[] = [];
+  let next: string | null = url;
+  while (next) {
+    const response = await fetch(next, {
+      headers: { Accept: 'application/vnd.api+json' },
+    });
+    if (!response.ok) {
+      throw new Error(`JSON:API enumeration failed: ${response.status} ${next}`);
+    }
+    const doc = (await response.json()) as {
+      data?: JsonApiItem[];
+      links?: { next?: { href?: string } };
+    };
+    items.push(...(doc.data ?? []));
+    next = doc.links?.next?.href ?? null;
+  }
+  return items;
+}
+
+/** Site-relative paths of all published pages the build should emit. */
+export async function enumeratePaths(): Promise<string[]> {
+  const [pages, articles] = await Promise.all([
+    collect(
+      `${SITE}/jsonapi/canvas_page/canvas_page?fields[canvas_page--canvas_page]=path,drupal_internal__id,status`,
+    ),
+    collect(
+      `${SITE}/jsonapi/node/article?fields[node--article]=path,drupal_internal__nid,status`,
+    ).catch(() => [] as JsonApiItem[]),
+  ]);
+  // Server-side filter[status]=1 silently returns an empty set for
+  // canvas_page (see the research doc), so published-only is client-side.
+  const paths = new Set<string>(['/']);
+  for (const item of pages) {
+    const a = item.attributes;
+    if (!a.status) continue;
+    paths.add(a.path?.alias || `/page/${a.drupal_internal__id}`);
+  }
+  for (const item of articles) {
+    const a = item.attributes;
+    if (!a.status) continue;
+    paths.add(a.path?.alias || `/node/${a.drupal_internal__nid}`);
+  }
+  return [...paths];
+}

<div{{ attributes }} style="padding:2rem;text-align:center;background:#eff6ff;border-radius:12px;margin:1rem;">
  <h2 style="margin-top:0;">{{ heading }}</h2>
  {% if show_buttons %}
    {% set buttons = [[button_text, button_link], [second_text, second_link], [third_text, third_link]]|slice(0, button_count|default(1)) %}
    <p>
      {% for button in buttons %}
        <a href="{{ button[1] }}" style="display:inline-block;margin:.25rem;padding:.6rem 1.2rem;border-radius:8px;font-weight:600;text-decoration:none;{{ loop.first ? 'background:#2563eb;color:#fff;' : 'border:2px solid #2563eb;color:#2563eb;' }}">{{ button[0] }}</a>
      {% endfor %}
    </p>
  {% endif %}
  {% if note and (not show_buttons or button_count|default(1) >= 2) %}<small style="color:#6b7280;">{{ note }}</small>{% endif %}
</div>

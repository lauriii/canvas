use Drupal\node\Entity\Node;
use Symfony\Component\Validator\Constraints\Hostname;
use Symfony\Component\Validator\Constraints\Ip;

/**
 * Implements hook_toolbar().
 */
function experience_builder_toolbar(): array {
  $user = \Drupal::currentUser();

  $items = [];
  $items['experience_builder'] = [
    '#cache' => [
      'contexts' => [
        'user.permissions',
      ],
    ],
  ];

  // @see experience_builder.routing.yml
  if ($user->hasPermission('access administration pages')) {
    $node = Node::load(1);
    // @todo How does work in 0.x if node 1 doesn't exist?
    if ($node) {
      $items['experience_builder'] += [
        '#type' => 'toolbar_item',
        'tab' => [
          '#type' => 'link',
          '#title' => t('Experience Builder PoC'),
          '#url' => Url::fromRoute('experience_builder.experience_builder', ['entity_type' => 'node', 'entity' => 1]),
          '#attributes' => [
            'title' => t('Experience Builder'),
            'class' => ['toolbar-icon', 'toolbar-icon-edit'],
          ],
        ],
        '#weight' => 1000,
      ];
    }
  }

  return $items;
}

/**
 * Implements hook_validation_constraint_alter().
 */
function experience_builder_validation_constraint_alter(array &$definitions): void {
  // Add the Symfony validation constraints that Drupal core does not add in
  // \Drupal\Core\Validation\ConstraintManager::registerDefinitions() for
  // unknown reasons. Do it defensively, to not break when this changes.
  if (!isset($definitions['Hostname'])) {
    // @see \Drupal\experience_builder\JsonSchemaInterpreter\JsonSchemaStringFormat::HOSTNAME
    // @see \Drupal\experience_builder\JsonSchemaInterpreter\JsonSchemaStringFormat::IDN_HOSTNAME
    $definitions['Hostname'] = [
      'label' => 'Hostname',
      'class' => Hostname::class,
      'type' => 'string',
      'provider' => 'core',
      'id' => 'Hostname',
    ];
    // @see \Drupal\experience_builder\JsonSchemaInterpreter\JsonSchemaStringFormat::IPV4
    // @see \Drupal\experience_builder\JsonSchemaInterpreter\JsonSchemaStringFormat::IPV6
    $definitions['Ip'] = [
      'label' => 'IP address',
      'class' => Ip::class,
      'type' => 'string',
      'provider' => 'core',
      'id' => 'Ip',
    ];
  }
}

/**
 * Implements hook_field_info_alter().
 */
function experience_builder_field_info_alter(array &$info): void {
  if (!empty($info['file'])) {
    $info['file']['class'] = FileItemOverride::class;
  }
  if (!empty($info['file_uri'])) {
    $info['file_uri']['class'] = FileUriItemOverride::class;
  }
  if (!empty($info['image'])) {
    $info['image']['class'] = ImageItemOverride::class;
  }
  if (!empty($info['link'])) {
    $info['link']['class'] = LinkItemOverride::class;
  }
  if (!empty($info['list_integer'])) {
    $info['list_integer']['class'] = ListIntegerItemOverride::class;
  }
  if (!empty($info['path'])) {
    $info['path']['class'] = PathItemOverride::class;
  }
  if (!empty($info['string'])) {
    $info['string']['class'] = StringItemOverride::class;
  }
  if (!empty($info['string_long'])) {
    $info['string_long']['class'] = StringLongItemOverride::class;
  }
  if (!empty($info['text'])) {
    $info['text']['class'] = TextItemOverride::class;
  }
  if (!empty($info['uuid'])) {
    $info['uuid']['class'] = UuidItemOverride::class;
  }
  if (!empty($info['uri'])) {
    $info['uri']['class'] = UriItemOverride::class;
  }
}

/**
 * Implements hook_entity_base_field_info_alter().
 */
function experience_builder_entity_base_field_info_alter(array &$fields, EntityTypeInterface $entity_type): void {
  // The File entity type's `filename` and `filemime` base fields use the
  // `string` field type but are NOT prose (which is the default semantic for
  // that field type).
  // @see \Drupal\experience_builder\Plugin\Field\FieldType\StringItemOverride
  if ($entity_type->id() === 'file') {
    // Override the default string semantics of the "string" field type.
    // @see \Drupal\experience_builder\Plugin\Field\FieldTypeOverride\StringItemOverride::propertyDefinitions()
    $fields['filename']->addPropertyConstraints('value', ['StringSemantics' => StringSemanticsConstraint::STRUCTURED]);
    $fields['filemime']->addPropertyConstraints('value', ['StringSemantics' => StringSemanticsConstraint::STRUCTURED]);
    $fields['uri']->setRequired(TRUE);
  }
  if ($entity_type->id() === 'taxonomy_term') {
    $fields['name']->addPropertyConstraints('value', ['StringSemantics' => StringSemanticsConstraint::PROSE]);
  }
}

/**
 * Implements hook_theme_suggestions_alter().
 */
function experience_builder_theme_suggestions_alter(array &$suggestions, array $variables): void {
  // Any element with #is_xb will have `--xbxb` suffixed versions of all of its
  // theme suggestions. When the semi coupled theme engine sees a filename
  // ending with this suffix, it bypasses Twig rendering and instead provides
  // an object that informs React rendering.
  if (!empty($variables['element']['#is_xb'])) {
    foreach ($suggestions as $suggestion) {
      if (!str_contains($suggestion, '__xbxb')) {
        $suggestions[] = $suggestion . '__xbxb';
      }
    }
    if (empty($suggestions)) {
      if (str_contains($variables["theme_hook_original"], '__')) {
        $base = explode('__', $variables["theme_hook_original"])[0];
        $suggestions[] = $base;
        $suggestions[] = $base . '__xbxb';
      }
      $suggestions[] = $variables["theme_hook_original"];
      $suggestions[] = $variables["theme_hook_original"] . '__xbxb';
    }
  }
}

/**
 * Implements hook_form_alter().
 */
function experience_builder_form_component_props_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  // The component edit form should be set as #is_xb, making it renderable by
  // React.
  $form['#is_xb'] = TRUE;
  // Recursively mark all the form elements as #is_xb, indicating they can be
  // rendered by React instead of Twig.
  _experience_builder_mark_xb($form, $form_id);
}

/**
 * Adds a TRUE #is_xb setting to all elements within a given $form.
 *
 * The #is_xb setting is then used by experience_builder_theme_suggestions_alter
 * to identify elements that should have suggestions for templates that will be
 * processed by the semi-coupled theme engine instead of Twig.
 *
 * @param array $form
 *   The form or form element which children should have form id attached.
 * @param string $form_id
 *   The form id attached to form elements.
 */
function _experience_builder_mark_xb(array &$form, string $form_id): void {
  foreach (Element::children($form) as $child) {
    if (!isset($form[$child]['#form_id'])) {
      $form[$child]['#form_id'] = $form_id;
    }
    $form[$child]['#is_xb'] = TRUE;

    _experience_builder_mark_xb($form[$child], $form_id);
  }
}

/**
 * Adds a TRUE #is_xb setting to form labels.
 *
 * TRICKY: this cannot happen in _experience_builder_mark_xb(), because form
 * labels are added after form altering — they are added *during* rendering.
 *
 * @see template_preprocess_form_element()
 */
function experience_builder_preprocess_form_element(array &$variables): void {
  if (!empty($variables['element']['#is_xb']) && !empty($variables['label'])) {
    $variables['label']['#is_xb'] = TRUE;
  }
}

function experience_builder_system_info_alter(array &$info, Extension $file, string $type): void {
  if ($type === 'theme') {
    if (isset($info['engine']) && $info['engine'] === 'twig') {
      // The semi-coupled theme engine makes it possible for templates with
      // filenames ending in --xbxb to be output as objects for eventual React
      // rendering. Filenames without this naming convention will be processed
      // as if they were using the Twig engine.
      $info['engine'] = 'semi_coupled';
    }
  }
}

/**
 * Implements hook_theme().
 */
function experience_builder_theme(array $existing, string $type, string $theme, string $path): array {
  $xb_templates = [];
  $extension = '.html.twig';
  $regex = '/' . str_replace('.', '\.', $extension) . '$/';
  // Get a listing of all template files in the path to search.
  $files = [];
  if (is_dir($path)) {
    $files = \Drupal::service('file_system')->scanDirectory($path, $regex, ['key' => 'filename']);
  }

  // For every existing theme hook, see if there is a supporting template that
  // ends with --xbxb somewhere in /templates then add it to the theme registry.
  foreach ($existing as $hook => $config) {
    $filename = $config['template'] . '--xbxb.html.twig';
    if (isset($files[$filename])) {
      $xb_templates[$hook . '__xbxb'] = [
        'base hook' => $hook,
        'path' => str_replace("/$filename", '', $files[$filename]->uri),
      ];
      if (isset($config['variables'])) {
        $xb_templates[$hook . '__xbxb']['variables'] = $config['variables'];
      }
    }
  }
  return $xb_templates;
}

/**
 * Implements hook_theme_registry_alter().
 */
function experience_builder_theme_registry_alter(array &$theme_registry): void {
  foreach ($theme_registry as $hook => $config) {
    if (str_ends_with($hook, '__xbxb')) {
      // Change to something other than 'module' so the render function from
      // semi_coupled is called by \Drupal\Core\Theme\ThemeManager::render. If
      // the theme registry comes from 'module' it will only use the render
      // function from twig.engine.
      $theme_registry[$hook]['type'] = 'xb_module';
    }
  }
}

/**
 * Implements hook_module_implements_alter().
 */
function experience_builder_module_implements_alter(array &$implementations, string $hook): void {
  // Make the theme and theme_suggestions_alter hooks in this module run last
  // so they are aware of all existing templates and theme implementations.
  if (in_array($hook, ['theme_suggestions_alter', 'theme'])) {
    $group = $implementations['experience_builder'];
    unset($implementations['experience_builder']);
    $implementations['experience_builder'] = $group;
  }
}

/**
 * Implements hook_storage_prop_shape_alter().
 *
 * (On behalf of the Media Library module.)
 *
 * Overrides the default: the "image" field type + widget.
 *
 * @see \Drupal\experience_builder\SdcPropJsonSchemaType::computeStorablePropShape()
 * @todo Move to Media Library module, eventually.
 */
function media_library_storage_prop_shape_alter(CandidateStorablePropShape $storable_prop_shape): void {
  if ($storable_prop_shape->shape->schema == ['type' => 'object', '$ref' => 'json-schema-definitions://experience_builder.module/image']) {
    // @todo Allow configuring which media type, for now this assumes the
    //   Standard 'image' media type.
    // @see core/profiles/standard/config/optional/media.type.image.yml
    if (!MediaType::load('image')) {
      return;
    }
    $storable_prop_shape->fieldTypeProp = new FieldTypeObjectPropsExpression('entity_reference', [
      'src' => new ReferenceFieldTypePropExpression(
        new FieldTypePropExpression('entity_reference', 'entity'),
        new ReferenceFieldPropExpression(
          new FieldPropExpression(EntityDataDefinition::create('media', 'image'), 'field_media_image', NULL, 'entity'),
          new FieldPropExpression(EntityDataDefinition::create('file'), 'uri', NULL, 'value'),
        )
      ),
      'alt' => new ReferenceFieldTypePropExpression(
        new FieldTypePropExpression('entity_reference', 'entity'),
        new FieldPropExpression(EntityDataDefinition::create('media', 'image'), 'field_media_image', NULL, 'alt'),
      ),
      'width' => new ReferenceFieldTypePropExpression(
        new FieldTypePropExpression('entity_reference', 'entity'),
        new FieldPropExpression(EntityDataDefinition::create('media', 'image'), 'field_media_image', NULL, 'width'),
      ),
      'height' => new ReferenceFieldTypePropExpression(
        new FieldTypePropExpression('entity_reference', 'entity'),
        new FieldPropExpression(EntityDataDefinition::create('media', 'image'), 'field_media_image', NULL, 'height'),
      ),
    ]);
    $storable_prop_shape->fieldStorageSettings = [
      'target_type' => 'media',
    ];
    $storable_prop_shape->fieldInstanceSettings = [
      'handler' => 'default:media',
      'handler_settings' => [
        'target_bundles' => [
          'image' => 'image',
        ],
      ],
    ];
    $storable_prop_shape->fieldWidget = 'media_library_widget';
  }
}

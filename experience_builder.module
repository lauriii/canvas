/**
 * Implements hook_toolbar().
 */
function experience_builder_toolbar(): array {
  $user = \Drupal::currentUser();

  $items = [];
  $items['experience_builder'] = [
    '#cache' => [
      'contexts' => [
        'user.permissions',
      ],
    ],
  ];

  // @see experience_builder.routing.yml
  if ($user->hasPermission('access administration pages')) {
    $node = Node::load(1);
    // @todo How does work in 0.x if node 1 doesn't exist?
    if ($node) {
      $items['experience_builder'] += [
        '#type' => 'toolbar_item',
        'tab' => [
          '#type' => 'link',
          '#title' => t('Experience Builder PoC'),
          '#url' => Url::fromRoute('experience_builder.experience_builder', ['entity_type' => 'node', 'entity' => 1]),
          '#attributes' => [
            'title' => t('Experience Builder'),
            'class' => ['toolbar-icon', 'toolbar-icon-edit'],
          ],
        ],
        '#weight' => 1000,
      ];
    }
  }

  return $items;
}

/**
 * Implements hook_validation_constraint_alter().
 */
function experience_builder_validation_constraint_alter(array &$definitions): void {
  // Add the Symfony validation constraints that Drupal core does not add in
  // \Drupal\Core\Validation\ConstraintManager::registerDefinitions() for
  // unknown reasons. Do it defensively, to not break when this changes.
  if (!isset($definitions['Hostname'])) {
    // @see \Drupal\experience_builder\JsonSchemaInterpreter\JsonSchemaStringFormat::HOSTNAME
    // @see \Drupal\experience_builder\JsonSchemaInterpreter\JsonSchemaStringFormat::IDN_HOSTNAME
    $definitions['Hostname'] = [
      'label' => 'Hostname',
      'class' => Hostname::class,
      'type' => 'string',
      'provider' => 'core',
      'id' => 'Hostname',
    ];
    // @see \Drupal\experience_builder\JsonSchemaInterpreter\JsonSchemaStringFormat::IPV4
    // @see \Drupal\experience_builder\JsonSchemaInterpreter\JsonSchemaStringFormat::IPV6
    $definitions['Ip'] = [
      'label' => 'IP address',
      'class' => Ip::class,
      'type' => 'string',
      'provider' => 'core',
      'id' => 'Ip',
    ];
  }
}

/**
 * Implements hook_field_info_alter().
 */
function experience_builder_field_info_alter(array &$info): void {
  if (!empty($info['file'])) {
    $info['file']['class'] = FileItemOverride::class;
  }
  if (!empty($info['file_uri'])) {
    $info['file_uri']['class'] = FileUriItemOverride::class;
  }
  if (!empty($info['image'])) {
    $info['image']['class'] = ImageItemOverride::class;
  }
  if (!empty($info['link'])) {
    $info['link']['class'] = LinkItemOverride::class;
  }
  if (!empty($info['list_integer'])) {
    $info['list_integer']['class'] = ListIntegerItemOverride::class;
  }
  if (!empty($info['path'])) {
    $info['path']['class'] = PathItemOverride::class;
  }
  if (!empty($info['string'])) {
    $info['string']['class'] = StringItemOverride::class;
  }
  if (!empty($info['string_long'])) {
    $info['string_long']['class'] = StringLongItemOverride::class;
  }
  if (!empty($info['text'])) {
    $info['text']['class'] = TextItemOverride::class;
  }
  if (!empty($info['uuid'])) {
    $info['uuid']['class'] = UuidItemOverride::class;
  }
  if (!empty($info['uri'])) {
    $info['uri']['class'] = UriItemOverride::class;
  }
}

/**
 * Implements hook_entity_base_field_info_alter().
 */
function experience_builder_entity_base_field_info_alter(array &$fields, EntityTypeInterface $entity_type): void {
  // The File entity type's `filename` and `filemime` base fields use the
  // `string` field type but are NOT prose (which is the default semantic for
  // that field type).
  // @see \Drupal\experience_builder\Plugin\Field\FieldType\StringItemOverride
  if ($entity_type->id() === 'file') {
    // Override the default string semantics of the "string" field type.
    // @see \Drupal\experience_builder\Plugin\Field\FieldTypeOverride\StringItemOverride::propertyDefinitions()
    $fields['filename']->addPropertyConstraints('value', ['StringSemantics' => StringSemanticsConstraint::STRUCTURED]);
    $fields['filemime']->addPropertyConstraints('value', ['StringSemantics' => StringSemanticsConstraint::STRUCTURED]);
    $fields['uri']->setRequired(TRUE);
  }
  if ($entity_type->id() === 'taxonomy_term') {
    $fields['name']->addPropertyConstraints('value', ['StringSemantics' => StringSemanticsConstraint::PROSE]);
  }
}

/**
 * Implements hook_entity_prepare_view().
 *
 * @see \Drupal\experience_builder\Plugin\Field\FieldType\ComponentTreeItem
 */
function experience_builder_entity_prepare_view(string $entity_type_id, array $entities, array $displays, string $view_mode): void {
  foreach ($entities as $entity) {
    // TRICKY: We only care about ContentEntityBase because we are trying to undo logic in
    // \Drupal\Core\Entity\ContentEntityBase::getTranslatedField(). In that method
    // non-translated fields have their parent entity set as the default translation
    // even if entity is not the default translation. This is a problem for the
    // component tree field type, because it may render dynamic properties
    // that reference the fields on the entity, and it needs to render the
    // translated fields when viewing a translation.
    // This unfortunately cannot be moved to ComponentTreeItem::view().
    // @see https://drupal.org/i/2513094
    // @see https://git.drupalcode.org/project/experience_builder/-/merge_requests/52/diffs#note_343826
    if ($entity instanceof ContentEntityBase && !$entity->isDefaultTranslation()) {
      foreach ($entity->getFields() as $field) {
        $field_entity = $field->getEntity();
        assert($field_entity instanceof ContentEntityBase);
        if ($field->getFieldDefinition()->getType() === 'component_tree' && $field_entity->isDefaultTranslation()) {
          $field_name = $field->getName();
          assert(is_string($field_name));
          $field->setContext($field_name, $entity->getTypedData());
        }
      }
    }
  }
}

/**
 * Implements hook_theme_suggestions_alter().
 */
function experience_builder_theme_suggestions_alter(array &$suggestions, array $variables): void {
  // Any element with #is_xb will have `--xbxb` suffixed versions of all of its
  // theme suggestions. When the semi coupled theme engine sees a filename
  // ending with this suffix, it bypasses Twig rendering and instead provides
  // an object that informs React rendering.
  if (!empty($variables['element']['#is_xb'])) {
    foreach ($suggestions as $suggestion) {
      if (!str_contains($suggestion, '__xbxb')) {
        $suggestions[] = $suggestion . '__xbxb';
      }
    }
    if (empty($suggestions)) {
      if (str_contains($variables["theme_hook_original"], '__')) {
        $base = explode('__', $variables["theme_hook_original"])[0];
        $suggestions[] = $base;
        $suggestions[] = $base . '__xbxb';
      }
      $suggestions[] = $variables["theme_hook_original"];
      $suggestions[] = $variables["theme_hook_original"] . '__xbxb';
    }

    if (in_array($variables["theme_hook_original"], ['container', 'field_multiple_value_form', 'fieldset']) && !empty($variables["element"]["#widget-type"])) {
      if ($variables["theme_hook_original"] === 'fieldset') {
        $suggestions[] = $variables["theme_hook_original"] . '__widget_' . str_replace('-', '_', $variables["element"]["#widget-type"]) . '__xbxb';
      }
      else {
        $suggestions[] = $variables["theme_hook_original"] . '__' . str_replace('-', '_', $variables["element"]["#widget-type"]) . '__xbxb';
      }
    }
    elseif (!empty($variables["element"]["#widget-type"])) {
      $suggestions[] = $variables["theme_hook_original"] . '__inwidget_' . str_replace('-', '_', $variables["element"]["#widget-type"]) . '__xbxb';
    }
  }
}

/**
 * Implements hook_form_alter().
 */
function experience_builder_form_component_props_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  // The component edit form should be set as #is_xb, making it renderable by
  // React.
  $form['#is_xb'] = TRUE;
}

/**
 * Adds a TRUE #is_xb setting to form labels.
 *
 * TRICKY: this cannot happen in RenderArrayXB::markXB(), because form
 * labels are added after form altering — they are added *during* rendering.
 *
 * @see template_preprocess_form_element()
 */
function experience_builder_preprocess_form_element(array &$variables): void {
  if (!empty($variables['element']['#is_xb']) && !empty($variables['label'])) {
    $variables['label']['#is_xb'] = TRUE;
  }
}

function experience_builder_system_info_alter(array &$info, Extension $file, string $type): void {
  if ($type === 'theme') {
    if (isset($info['engine']) && $info['engine'] === 'twig') {
      // The semi-coupled theme engine makes it possible for templates with
      // filenames ending in --xbxb to be output as objects for eventual React
      // rendering. Filenames without this naming convention will be processed
      // as if they were using the Twig engine.
      $info['engine'] = 'semi_coupled';
    }
  }
}

/**
 * Implements hook_theme().
 */
function experience_builder_theme(array $existing, string $type, string $theme, string $path): array {
  $xb_templates = [];
  $extension = '.html.twig';
  $regex = '/' . str_replace('.', '\.', $extension) . '$/';
  // Get a listing of all template files in the path to search.
  $files = [];
  if (is_dir($path)) {
    $files = \Drupal::service('file_system')->scanDirectory($path, $regex, ['key' => 'filename']);
  }

  // For every existing theme hook, see if there is a supporting template that
  // ends with --xbxb somewhere in /templates then add it to the theme registry.
  foreach ($existing as $hook => $config) {
    $filename = $config['template'] . '--xbxb.html.twig';
    if (isset($files[$filename])) {
      $xb_templates[$hook . '__xbxb'] = [
        'base hook' => $hook,
        'path' => str_replace("/$filename", '', $files[$filename]->uri),
      ];
      if (isset($config['variables'])) {
        $xb_templates[$hook . '__xbxb']['variables'] = $config['variables'];
      }
      unset($files[$filename]);
    }
  }

  // Also create theme hooks for variants.
  foreach ($files as $file => $file_obj) {
    $name_parts = explode('--', basename($file, '.html.twig'));
    // The part of the filename following the final '--'.
    $final = array_pop($name_parts);
    // The base hook aka the part before the first '--'.
    $the_hook = array_shift($name_parts);

    // Step backwards through '--' uses until an existing hook is found, and
    // specify that as the base hook.
    if ($final === 'xbxb' && !empty($name_parts) && isset($existing[$the_hook])) {
      $new_hook = $the_hook . '__' . str_replace('-', '_', implode('__', $name_parts)) . '__xbxb';
      $base_hook = $the_hook . (count($name_parts) > 0 ? '__' . implode('__', $name_parts) : '');
      while (!isset($existing[$base_hook]) || $base_hook !== $the_hook) {
        $split_pos = strrpos($base_hook, '__');
        if ($split_pos) {
          $base_hook = substr($base_hook, 0, (int) $split_pos);
        }
      }
      $xb_templates[$new_hook] = [
        'base hook' => $base_hook,
        'path' => str_replace("/$file", '', $file_obj->uri),
      ];
      if (isset($existing[$the_hook]['variables'])) {
        $xb_templates[$new_hook]['variables'] = $existing[$the_hook]['variables'];
      }
    }
  }
  return $xb_templates;
}

/**
 * Implements hook_theme_registry_alter().
 */
function experience_builder_theme_registry_alter(array &$theme_registry): void {
  foreach ($theme_registry as $hook => $config) {
    if (str_ends_with($hook, '__xbxb')) {
      // Change to something other than 'module' so the render function from
      // semi_coupled is called by \Drupal\Core\Theme\ThemeManager::render. If
      // the theme registry comes from 'module' it will only use the render
      // function from twig.engine.
      $theme_registry[$hook]['type'] = 'xb_module';
      $theme_registry[str_replace('__xbxb', '', $hook)]['type'] = 'xb_module';
    }
  }
}

/**
 * Implements hook_module_implements_alter().
 */
function experience_builder_module_implements_alter(array &$implementations, string $hook): void {
  // Make the theme and theme_suggestions_alter hooks in this module run last
  // so they are aware of all existing templates and theme implementations.
  if (in_array($hook, ['theme_suggestions_alter', 'theme'])) {
    $group = $implementations['experience_builder'];
    unset($implementations['experience_builder']);
    $implementations['experience_builder'] = $group;
  }
}

/**
 * Implements hook_storage_prop_shape_alter().
 *
 * (On behalf of the Media Library module.)
 *
 * Overrides the default: the "image" field type + widget.
 *
 * @see \Drupal\experience_builder\SdcPropJsonSchemaType::computeStorablePropShape()
 * @todo Move to Media Library module, eventually.
 */
function media_library_storage_prop_shape_alter(CandidateStorablePropShape $storable_prop_shape): void {
  if ($storable_prop_shape->shape->schema == ['type' => 'object', '$ref' => 'json-schema-definitions://experience_builder.module/image']) {
    // @todo Allow configuring which media type, for now this assumes the
    //   Standard 'image' media type.
    // @see core/profiles/standard/config/optional/media.type.image.yml
    if (!MediaType::load('image')) {
      return;
    }

    $storable_prop_shape->fieldTypeProp = new FieldTypeObjectPropsExpression('entity_reference', [
      'src' => new ReferenceFieldTypePropExpression(
        new FieldTypePropExpression('entity_reference', 'entity'),
        new ReferenceFieldPropExpression(
          new FieldPropExpression(EntityDataDefinition::create('media', 'image'), 'field_media_image', NULL, 'entity'),
          new FieldPropExpression(EntityDataDefinition::create('file'), 'uri', NULL, 'url'),
        )
      ),
      'alt' => new ReferenceFieldTypePropExpression(
        new FieldTypePropExpression('entity_reference', 'entity'),
        new FieldPropExpression(EntityDataDefinition::create('media', 'image'), 'field_media_image', NULL, 'alt'),
      ),
      'width' => new ReferenceFieldTypePropExpression(
        new FieldTypePropExpression('entity_reference', 'entity'),
        new FieldPropExpression(EntityDataDefinition::create('media', 'image'), 'field_media_image', NULL, 'width'),
      ),
      'height' => new ReferenceFieldTypePropExpression(
        new FieldTypePropExpression('entity_reference', 'entity'),
        new FieldPropExpression(EntityDataDefinition::create('media', 'image'), 'field_media_image', NULL, 'height'),
      ),
    ]);
    $storable_prop_shape->fieldStorageSettings = [
      'target_type' => 'media',
    ];
    $storable_prop_shape->fieldInstanceSettings = [
      'handler' => 'default:media',
      'handler_settings' => [
        'target_bundles' => [
          'image' => 'image',
        ],
      ],
    ];
    $storable_prop_shape->fieldWidget = 'media_library_widget';
  }
}

/**
 * Implements hook_library_info_alter().
 */
function experience_builder_library_info_alter(array &$libraries, string $extension): void {
  $route_name = \Drupal::routeMatch()->getRouteName();
  if ($route_name === 'experience_builder.experience_builder' && $extension === 'olivero') {
    // Olivero's `drupal.message` depends on `olivero/global-styling` to ensure
    // a particular ordering only. This causes JS to be loaded in the incorrect
    // order.
    // @see https://git.drupalcode.org/project/experience_builder/-/merge_requests/154#note_356130
    // @see https://www.drupal.org/node/2987444#mr3609-note158377
    // @todo Remove this alter hook implementation once https://www.drupal.org/node/1945262 updates `olivero/drupal.message`.
    unset($libraries['drupal.message']['js']);
    // To be valid it needs either js, css, drupalSettings, or dependencies.
    // Referencing a library that already exists to keep it legit but inert.
    $libraries['drupal.message']['dependencies'] = ['core/drupal'];
  }
}

/**
 * Implements hook_field_widget_complete_form_alter().
 *
 * Provide additional context to experience_builder_theme_suggestions_alter().
 */
function experience_builder_field_widget_complete_form_alter(array &$field_widget_complete_form, FormStateInterface $form_state, array $context): void {
  $field_widget_complete_form['#widget-type'] = $context['widget']->getPluginId();
  if (isset($field_widget_complete_form['widget']) && is_array($field_widget_complete_form["widget"])) {
    $field_widget_complete_form["widget"]['#widget-type'] = $context['widget']->getPluginId();
    foreach (Element::children($field_widget_complete_form['widget']) as $key) {
      $field_widget_complete_form['widget'][$key]['#widget-type'] = $context['widget']->getPluginId();
    }
  }
  if (isset($context['form']['#parents']) && array_search('xb_component_props', $context["form"]["#parents"]) !== FALSE) {
    RenderArrayXB::markXB($field_widget_complete_form);
    if ($context['widget']->getPluginId() === 'media_library_widget') {
      $config = \Drupal::service('config.factory')->getEditable('system.performance');
      $js_preprocess = $config->get('js.preprocess');
      if (!empty($js_preprocess)) {
        $field_widget_complete_form['#suffix'] = 'Warning: This site has JS aggregation enabled. The media library widget will not work unless it is disabled. This will, of course, be addressed soon.';
      }
    }
  }
}

/**
 * Implements hook_field_widget_single_element_WIDGET_TYPE_form_alter().
 *
 * @see \Drupal\experience_builder\MediaLibraryXbPropOpener
 */
function experience_builder_field_widget_single_element_media_library_widget_form_alter(array &$form, FormStateInterface $form_state, array $context): void {
  // Use an XB-specific media library opener, because the default opener assumes
  // the media library is opened for a field widget of a field instance on the
  // host entity type. That is not true for XB's "static prop sources".
  // @see \Drupal\experience_builder\PropSource\StaticPropSource
  // @see \Drupal\experience_builder\Form\ComponentPropsForm::buildForm()
  if ($form_state->get('is_xb_static_prop_source') !== TRUE) {
    return;
  }

  // @see \Drupal\media_library\Plugin\Field\FieldWidget\MediaLibraryWidget::formElement()
  assert(array_key_exists('open_button', $form));
  assert(array_key_exists('#media_library_state', $form['open_button']));
  $old = $form['open_button']['#media_library_state'];
  assert($old instanceof MediaLibraryState);
  $form['open_button']['#media_library_state'] = MediaLibraryState::create(
    'experience_builder.media_library.opener',
    $old->getAllowedTypeIds(),
    $old->getSelectedTypeId(),
    $old->getAvailableSlots(),
    [
      // This single opener parameter is necessary.
      // @see \Drupal\experience_builder\MediaLibraryXbPropOpener::getSelectionResponse()
      'field_widget_id' => $old->getOpenerParameters()['field_widget_id'],
    ]
  );
}

/**
 * Implements hook_preprocess_media_library_item__widget().
 *
 * Retrieves the typed data contained by the selected Media entity (if it uses
 * an `image` media source), and makes it available to the XB UI as a
 * `data-media-file` attribute.
 *
 * @see media_library_storage_prop_shape_alter()
 * @todo Revisit in https://www.drupal.org/project/experience_builder/issues/3463842
 */
function experience_builder_preprocess_media_library_item__widget(array &$variables): void {
  $media_id = $variables['element']['remove_button']['#media_id'] ?? NULL;
  $string_split = 'media-library-remove-button-';
  $offset = strpos($variables['element']['remove_button']['#name'], $string_split) + strlen($string_split);
  $associated_field_name = substr($variables['element']['remove_button']['#name'], $offset);
  $variables['content']['remove_button']['#attributes']['data-media-field-name'] = $associated_field_name;
  if ($media_id) {
    $media = Media::load($media_id);
    if (is_null($media)) {
      return;
    }
    $field = $media->get('field_media_' . $media->bundle());
    $fid = $field->getValue()[0]['target_id'];
    $media_file = File::load($fid);
    $value = $field->getValue()[0];
    if (is_null($media_file) || is_null($value)) {
      return;
    }
    // For now, this only supports image media.
    // @see media_library_storage_prop_shape_alter()
    if ($media->bundle() !== 'image') {
      return;
    }
    $prepared = array_intersect_key([
      ...$value,
      // @todo Figure out how to remove these hard-coded assumptions in https://www.drupal.org/project/experience_builder/issues/3463842 — this is assuming `type: string, format: uri-reference` (or more specifically: `$ref: json-schema-definitions://experience_builder.module/image-uri`)
      'src' => $media_file->createFileUrl(),
    ], ['src' => '', 'alt' => '', 'width' => '', 'height' => '']);

    $variables["content"]["remove_button"]["#attributes"]['data-media-file'] = Json::encode($prepared);
  }
}

/**
 * Implements hook_modules_installed().
 */
function experience_builder_modules_installed(array $modules, bool $is_syncing): void {
  if ($is_syncing) {
    return;
  }
  // The module installer cleared all plugin caches. Force new/changed SDCs to create/update Component config entities.
  \Drupal::service(ComponentPluginManager::class)->getDefinitions();
}

/**
 * Implements hook_rebuild().
 */
function experience_builder_rebuild(): void {
  // The module installer cleared all plugin caches. Force new/changed SDCs to create/update Component config entities.
  \Drupal::service(ComponentPluginManager::class)->getDefinitions();
}

<?php

require_once 'src/PropExpressions.php';

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Field\FieldItemInterface;
use Drupal\Core\Template\Attribute;
use Drupal\experience_builder\ComponentPropExpression;
use Drupal\experience_builder\FieldPropExpression;
use Drupal\experience_builder\FieldTypePropExpression;
use Drupal\experience_builder\Plugin\Field\FieldType\FileItemOverride;
use Drupal\experience_builder\Plugin\Field\FieldType\FileUriItemOverride;
use Drupal\experience_builder\Plugin\Field\FieldType\ImageItemOverride;
use Drupal\experience_builder\Plugin\Field\FieldType\LinkItemOverride;
use Drupal\experience_builder\Plugin\Field\FieldType\PathItemOverride;
use Drupal\experience_builder\Plugin\Field\FieldType\StringItemOverride;
use Drupal\experience_builder\Plugin\Field\FieldType\StringLongItemOverride;
use Drupal\experience_builder\Plugin\Field\FieldType\TextItemOverride;
use Drupal\experience_builder\Plugin\Field\FieldType\UuidItemOverride;
use Drupal\experience_builder\Plugin\Validation\Constraint\StringSemanticsConstraint;
use Drupal\experience_builder\SdcPropJsonSchemaType;
use Drupal\experience_builder\SdcPropToFieldTypePropMatcher;
use Drupal\sdc\ComponentPluginManager;
use Symfony\Component\Validator\Constraints\Hostname;
use Symfony\Component\Validator\Constraints\Ip;

/**
 * Implements hook_validation_constraint_alter().
 */
function experience_builder_validation_constraint_alter(array &$definitions) {
  // Add the Symfony validation constraints that Drupal core does not add in
  // \Drupal\Core\Validation\ConstraintManager::registerDefinitions() for
  // unknown reasons. Do it defensively, to not break when this changes.
  if (!isset($definitions['Hostname'])) {
    // @see \Drupal\experience_builder\JsonSchemaInterpreter\JsonSchemaStringFormat::HOSTNAME
    // @see \Drupal\experience_builder\JsonSchemaInterpreter\JsonSchemaStringFormat::IDN_HOSTNAME
    $definitions['Hostname'] = [
      'label' => 'Hostname',
      'class' => Hostname::class,
      'type' => 'string',
      'provider' => 'core',
      'id' => 'Hostname',
    ];
    // @see \Drupal\experience_builder\JsonSchemaInterpreter\JsonSchemaStringFormat::IPV4
    // @see \Drupal\experience_builder\JsonSchemaInterpreter\JsonSchemaStringFormat::IPV6
    $definitions['Ip'] = [
      'label' => 'IP address',
      'class' => Ip::class,
      'type' => 'string',
      'provider' => 'core',
      'id' => 'Ip',
    ];
  }
}

/**
 * Implements hook_field_info_alter().
 */
function experience_builder_field_info_alter(&$info) {
  if (!empty($info['file'])) {
    $info['file']['class'] = FileItemOverride::class;
  }
  if (!empty($info['file_uri'])) {
    $info['file_uri']['class'] = FileUriItemOverride::class;
  }
  if (!empty($info['image'])) {
    $info['image']['class'] = ImageItemOverride::class;
  }
  if (!empty($info['link'])) {
    $info['link']['class'] = LinkItemOverride::class;
  }
  if (!empty($info['path'])) {
    $info['path']['class'] = PathItemOverride::class;
  }
  if (!empty($info['string'])) {
    $info['string']['class'] = StringItemOverride::class;
  }
  if (!empty($info['string_long'])) {
    $info['string_long']['class'] = StringLongItemOverride::class;
  }
  if (!empty($info['text'])) {
    $info['text']['class'] = TextItemOverride::class;
  }
  if (!empty($info['uuid'])) {
    $info['uuid']['class'] = UuidItemOverride::class;
  }
}

/**
 * Implements hook_entity_base_field_info_alter().
 */
function experience_builder_entity_base_field_info_alter(&$fields, \Drupal\Core\Entity\EntityTypeInterface $entity_type) {
  // The File entity type's `filename` and `filemime` base fields use the
  // `string` field type but are NOT prose (which is the default semantic for
  // that field type).
  // @see \Drupal\experience_builder\Plugin\Field\FieldType\StringItemOverride
  if ($entity_type->id() === 'file') {
    $fields['filename']->addPropertyConstraints('value', ['StringSemantics' => StringSemanticsConstraint::STRUCTURED]);
    $fields['filemime']->addPropertyConstraints('value', ['StringSemantics' => StringSemanticsConstraint::STRUCTURED]);
    $fields['uri']->setRequired(TRUE);
  }
  if ($entity_type->id() === 'taxonomy_term') {
    $fields['name']->addPropertyConstraints('value', ['StringSemantics' => StringSemanticsConstraint::PROSE]);
  }
}

function _eb_resolve_sdc_prop_value(\Drupal\Core\Entity\ContentEntityInterface $host_entity, array $sdc_prop_source) {
  // @todo convert this to a value object?
  $missing = array_diff(['sourceType', 'expression'], array_keys($sdc_prop_source));
  if (!empty($missing)) {
    throw new \LogicException(sprintf('Missing the keys %s.', implode(',', $missing)));
  }

  $typed_data_manager = \Drupal::service(\Drupal\Core\TypedData\TypedDataManagerInterface::class);
  assert($typed_data_manager instanceof \Drupal\Core\TypedData\TypedDataManagerInterface);

  if (str_starts_with($sdc_prop_source['sourceType'], 'static:')) {
    // `sourceType = static` requires a value to be specified.
    $missing = array_diff(['value'], array_keys($sdc_prop_source));
    if (!empty($missing)) {
      throw new \LogicException(sprintf('Missing the keys %s.', implode(',', $missing)));
    }

    // First: conjure the expected FieldItem instance.
    [,$data_type] = explode(':', $sdc_prop_source['sourceType'], 2);
    $field_item_definition = $typed_data_manager->createDataDefinition($data_type);
    $field_item = $typed_data_manager->createInstance($data_type, [
      'name' => NULL,
      'parent' => NULL,
      'data_definition' => $field_item_definition,
    ]);
    assert($field_item instanceof FieldItemInterface);
    $field_item->setValue($sdc_prop_source['value']);

    // @todo Remove this when this logic is moved into a field type and it actually gets saved and has test coverage.
    // @todo This won't work for fields whose props are objects (ComplexData)/lists (ListInterface), but core does not use that AFAIK, so fine for now.
    $expected_to_be_stored = $field_item->toArray();
    match (count($field_item_definition->getPropertyDefinitions())) {
      1 => (function() use ($expected_to_be_stored, $sdc_prop_source, $field_item) {
        if ($expected_to_be_stored[$field_item::mainPropertyName()] !== $sdc_prop_source['value']) {
          throw new \LogicException(sprintf('Unexpected static prop value: %s should be %s', json_encode($sdc_prop_source['value']), json_encode($expected_to_be_stored[$field_item::mainPropertyName()])));
        }
      })(),
      default => (function() use ($expected_to_be_stored, $sdc_prop_source) {
        if ($expected_to_be_stored !== $sdc_prop_source['value']) {
          throw new \LogicException(sprintf('Unexpected static prop value: %s should be %s', json_encode($sdc_prop_source['value']), json_encode($expected_to_be_stored)));
        }
      })(),
    };

    // Second: construct an expression object from the expression string.
    if (str_contains($sdc_prop_source['expression'], '{')) {
      $expression = \Drupal\experience_builder\FieldTypeObjectPropsExpression::fromString($sdc_prop_source['expression']);
    }
    else {
      $expression = FieldTypePropExpression::fromString($sdc_prop_source['expression']);
    }

    // Finally: evaluate expression using the field item.
    $value = \Drupal\experience_builder\PropExpressionEvaluator::evaluate($field_item, $expression);
  }

  if ($sdc_prop_source['sourceType'] === 'dynamic') {
    // First: construct an expression object from the expression string.
    if (str_contains($sdc_prop_source['expression'], '{')) {
      $expression = \Drupal\experience_builder\FieldObjectPropsExpression::fromString($sdc_prop_source['expression']);
    }
    else if (str_contains($sdc_prop_source['expression'], 'entity␜︎␜entity:')) {
      $expression = \Drupal\experience_builder\ReferenceFieldPropExpression::fromString($sdc_prop_source['expression']);
    }
    else {
      $expression = FieldPropExpression::fromString($sdc_prop_source['expression']);
    }
    // Second: evaluate expression using the field item.
    $value = \Drupal\experience_builder\PropExpressionEvaluator::evaluate($host_entity, $expression);
  }

  return $value;
}

/**
 * Implements hook_entity_view_alter().
 *
 * To PoC storing SDCs + fixed values + mapped values
 */
function experience_builder_entity_view_alter(&$build, EntityInterface $entity, EntityViewDisplayInterface $display) {
  $sdc_manager = \Drupal::service('plugin.manager.sdc');
  assert($sdc_manager instanceof ComponentPluginManager);
  $matcher = \Drupal::service(SdcPropToFieldTypePropMatcher::class);
  assert($matcher instanceof SdcPropToFieldTypePropMatcher);

  // Demonstrate the SdcPropToFieldTypePropMatcher infrastructure using a single
  // component but for any entity type.
  $component = $sdc_manager->find('sdc_test:my-cta');
  $prop_names = array_keys($component->metadata->schema['properties'] ?? []);
  $props = [];
  foreach ($prop_names as $prop_name) {
    $schema = $component->metadata->schema['properties'][$prop_name];

    // TRICKY: `attributes` is a special case — it is kind of a reserved
    // prop.
    // @see \Drupal\sdc\Twig\TwigExtension::mergeAdditionalRenderContext()
    if ($prop_name === 'attributes') {
      assert($schema['type'][0] === Attribute::class);
      continue;
    }

    $primitive_type = SdcPropJsonSchemaType::from(
    // TRICKY: SDC always allowed `object` for Twig integration reasons.
    // @see \Drupal\sdc\Component\ComponentMetadata::parseSchemaInfo()
      is_array($schema['type']) ? $schema['type'][0] : $schema['type']
    );

    // @see https://json-schema.org/understanding-json-schema/reference/object#required
    // @see https://json-schema.org/learn/getting-started-step-by-step#required
    $is_required = in_array($prop_name, $component->metadata->schema['required'] ?? [], TRUE);

    $props[$prop_name] = array_filter(
      $matcher->findFieldInstanceFormatMatches($primitive_type, $is_required, $schema),
      function (FieldPropExpression|\Drupal\experience_builder\ReferenceFieldPropExpression $expr) use ($entity) {
        $et = $expr instanceof \Drupal\experience_builder\ReferenceFieldPropExpression
          ? $expr->referencer->entityType
          : $expr->entityType;
        return $et->getEntityTypeId() === $entity->getEntityTypeId() && $et->getBundles() === [$entity->bundle()];
      }
    );
  }

  $build['experience_builder_sdc_data_storage_test'] = [
    '#type' => 'container',
    '#weight' => -100,
    '#prefix' => '<h1>A complex SDC rendered from multiple sources</h1>',
  ];



  $experience_builder_layout_field = json_decode(json_encode([
    'static-image-56r' => ['type' => 'experience_builder:image'],
    'dynamic-image-udf7d' => ['type' => 'experience_builder:image'],
    'static-static-card1ab' => ['type' => $component->getPluginId()],
    'dynamic-static-card2df' => ['type' => $component->getPluginId()],
    'dynamic-dynamic-card3rr' => ['type' => $component->getPluginId()],
  ]), TRUE);


  $experience_builder_values_field = json_decode(json_encode([
    'dynamic-static-card2df' => [
      'text' => [
        'sourceType' => 'dynamic',
        // Either expression works:
//        'expression' => 'ℹ︎␜entity:node:foo␝title␞␟value',
        'expression' => 'ℹ︎␜entity:node:foo␝field_call_to_action␞␟value',
      ],
      'href' => [
        'sourceType' => 'static:field_item:link',
        'value' => ['uri' => 'https://drupal.org', 'title' => NULL, 'options' => []],
        'expression' => 'ℹ︎link␟uri',
      ],
    ],
    'static-static-card1ab' => [
      'text' => [
        'sourceType' => 'static:field_item:string',
        'value' =>'hello, world!',
        'expression' => 'ℹ︎string␟value',
      ],
      'href' => [
        'sourceType' => 'static:field_item:link',
        'value' => ['uri' => 'https://drupal.org', 'title' => NULL, 'options' => []],
        'expression' => 'ℹ︎link␟uri',
      ],
    ],
    'dynamic-dynamic-card3rr' => [
      'text' => [
        'sourceType' => 'dynamic',
        'expression' => 'ℹ︎␜entity:node:foo␝title␞␟value',
      ],
      'href' => [
        'sourceType' => 'dynamic',
        'expression' => 'ℹ︎␜entity:node:foo␝field_image␞␟entity␜︎␜entity:file␝uri␞␟value',
      ],
    ],
    'static-image-56r' => [
      'image' => [
        'sourceType' => 'static:field_item:link',
        'value' => ['uri' => 'https://www.drupal.org/files/cta_multiple/featured_image/drupal-evergreen-icon-250X230px_0.png', 'title' => NULL, 'options' => []],
        // This expression would trigger the exception `Drupal\sdc\Exception\InvalidComponentException: [image] String value found, but an object is required`.
//        'expression' => 'ℹ︎link␟uri',
        'expression' => 'ℹ︎link␟{src↠uri}',
      ],
    ],
    'dynamic-image-udf7d' => [
      'image' => [
        'sourceType' => 'dynamic',
        'expression' => 'ℹ︎␜entity:node:foo␝field_image␞␟{src↝entity␜ℹ︎␜entity:file␝uri␞␟url, alt↠alt, width↠width, height↠height}',
      ],
    ],
  ]), TRUE);

  foreach ($experience_builder_layout_field as $uuid => $assigned_sdc) {
    $sdc_component_id = $assigned_sdc['type'];

    $props = [];
    foreach ($experience_builder_values_field[$uuid] as $prop_name => $prop_value_source) {
      $props[$prop_name] = _eb_resolve_sdc_prop_value($entity, $prop_value_source);
    }
    $build['experience_builder_sdc_data_storage_test'][$uuid] = [
      '#prefix' => "<h2>$uuid</h2>",
      'component' => [
        '#type' => 'component',
        '#component' => $sdc_component_id,
        '#props' => $props,
        '#slots' => [],
      ],
      '#suffix' => '<hr>',
    ];
  }
  return $build;

  // Generate all possible permutations.
  $build['experience_builder_sdc_random_prop_expressions_overview'] = [
    '#type' => 'container',
    '#weight' => -100,
    '#prefix' => sprintf('<h1>Available matches for <code>%s</code> on <code>%s:%s</code> %d</h1>', $component->getPluginId(), $entity->getEntityTypeId(), $entity->bundle(), $entity->id()),
  ];
  foreach ($props as $prop_name => $matches) {
    $build['experience_builder_sdc_random_prop_expressions_overview'][$prop_name] = [
      '#theme' => 'item_list',
      '#title' => \Drupal\Core\Render\Markup::create("Component prop: <code>$prop_name</code>"),
      '#items' => array_map(fn (\Drupal\experience_builder\StructuredDataPropExpressionInterface $e) => (string) $e, $matches),
      '#empty' => 'No matches found',
    ];
  }

  $permutations = [];
  $first_prop_name = array_keys($props)[0];
  foreach ($props[$first_prop_name] as $expr) {
    $permutation = [$first_prop_name => $expr];
    // Get the first match (if any) for all other props.
    foreach (array_keys(array_diff_key($props, array_flip([$first_prop_name]))) as $other_prop_name) {
      $permutation[$other_prop_name] = !empty($props[$other_prop_name])
        ? reset($props[$other_prop_name])
        : NULL;
    }
    $permutations[(string) $expr] = $permutation;
  }

  $permutation_id = 0;
  foreach ($permutations as $label => $prop_exprs) {
    $permutation_id++;
    $evaluated_prop_exprs = array_map(
      fn(FieldPropExpression|\Drupal\experience_builder\ReferenceFieldPropExpression $e) => \Drupal\experience_builder\PropExpressionEvaluator::evaluate($entity, $e),
      array_filter($prop_exprs)
    );
    $build['experience_builder_sdc_random_prop_expressions']['preview' . $permutation_id] = [
      '#weight' => -100,
      '#prefix' => \Drupal\Core\Render\Markup::create('<h3>Permutation #' . $permutation_id . '</h3><p>👉 <code>' . $label . '</code></p><div style="border: 1px solid black; padding: 2em">'),
      '#suffix' => '</div><hr>',
    ];
    if ($evaluated_prop_exprs[$first_prop_name] === NULL) {
      $build['experience_builder_sdc_random_prop_expressions']['preview' . $permutation_id] += [
        '#markup' => sprintf(
          '<p>❌ FAILURE: the <code>%s</code> prop resolved to NULL because field requiredness is not yet taken into account.</p>',
          $first_prop_name,
        ),
      ];
    }
    else {
      $build['experience_builder_sdc_random_prop_expressions']['preview' . $permutation_id] += [
        'component' => [
          '#type' => 'component',
          '#component' => $component->getPluginId(),
          '#props' => ['href' => 'https://drupal.org'] + $evaluated_prop_exprs,
          '#slots' => [],
        ],
      ];
    }
  }
}

---
import DraftSession from '@drupal-canvas/headless-astro/DraftSession.astro';

/**
 * The app's session banner, slotted into the SDK's DraftSession component.
 * The SDK owns the session lifecycle (expiry timing, the renewal protocol
 * with the embedding host, re-arming after a renewal) and the visibility of
 * the marked views; this component owns presentation:
 *
 * - Standalone, the yellow "active" banner shows, with an exit form. The
 *   red "expired" banner adds a "Renew session" link — a top-level
 *   navigation through Drupal, the one request shape that still carries
 *   Drupal's SameSite=Lax session cookie cross-site.
 * - Embedded, the host owns the chrome, so nothing renders — with one
 *   exception: an *expired* session shows the red banner even embedded, as
 *   the last-resort fallback for a host that does not speak the protocol.
 *   Expiry going invisible inside an iframe was the problem that motivated
 *   the protocol.
 */
---

<DraftSession>
  <div
    data-draft-session-view="expired"
    class="flex items-center justify-between gap-4 bg-red-200 px-4 py-2 text-sm text-red-950"
  >
    <span>
      <strong>Draft preview session expired.</strong> Showing only content
      visible to anonymous visitors.
    </span>
    <span class="flex gap-4">
      <a data-draft-session-renew-link class="font-semibold underline">
        Renew session
      </a>
      <!--
        Exiting draft mode is a POST form, not a link: exiting changes
        state (it clears the session cookies), and a GET link would be
        eligible for prefetching, which could end the session without a
        click. A plain form needs no JavaScript and nothing prefetches it.
      -->
      <form method="POST" action="/api/disable-draft">
        <button
          type="submit"
          class="cursor-pointer font-semibold underline"
        >
          Exit draft mode
        </button>
      </form>
    </span>
  </div>

  <div
    data-draft-session-view="active"
    class="flex items-center justify-between gap-4 bg-amber-300 px-4 py-2 text-sm text-amber-950"
  >
    <span>
      <strong>Draft mode is active.</strong> You may be seeing unpublished
      content.
    </span>
    <form method="POST" action="/api/disable-draft">
      <button type="submit" class="cursor-pointer font-semibold underline">
        Exit draft mode
      </button>
    </form>
  </div>
</DraftSession>

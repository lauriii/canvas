# Base URL of the Drupal site. Plain http because the Node.js process does
# not trust DDEV's mkcert certificate by default; for the https URL, point
# NODE_EXTRA_CA_CERTS at the mkcert root CA instead.
DRUPAL_BASE_URL=http://canvas-env.ddev.site

# Space-separated origins allowed to embed this app in an iframe
# (CSP frame-ancestors). 'self' is always allowed in addition to these.
# The same origins are the app's postMessage peers for the session renewal
# protocol: status/renew messages are only exchanged with hosts on this
# list. This must include the Drupal origin hosting the Canvas editor.
DRAFT_ALLOWED_FRAME_ANCESTORS=https://canvas-env.ddev.site

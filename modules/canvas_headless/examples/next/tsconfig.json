{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      // The @drupal-canvas/headless packages are consumed as raw TypeScript
      // through file: links, so tsc follows their import chain into the
      // @drupal-canvas/discovery sources, which reference the canonical
      // component types in the Canvas UI package by path alias. These
      // exact-match mappings (which take precedence over the @/* wildcard)
      // make that chain resolvable. They become unnecessary once the
      // packages are published compiled.
      "@drupal-canvas/ui/types/CodeComponent": [
        "../../../../ui/src/types/CodeComponent.ts"
      ],
      "@/types/CodeComponent": ["../../../../ui/src/types/CodeComponent.ts"],
      "@/features/code-editor/component-data/derivedPropTypes": [
        "../../../../ui/src/features/code-editor/component-data/derivedPropTypes.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}

<?php

/**
 * @file
 * Install and update hooks for the Drupal Canvas AI module.
 */

declare(strict_types=1);

use Drupal\Core\Extension\ModuleInstallerInterface;

/**
 * Implements hook_install().
 */
function canvas_ai_install(bool $is_syncing): void {
  if ($is_syncing) {
    return;
  }
  // These IDs name ai_agent config entities this module ships. A module's
  // simple config is saved before its config entities are created, so shipping
  // these values in config/install would save settings whose `ConfigExists`
  // constraints cannot yet hold.
  // @see \Drupal\Core\Extension\ModuleInstaller::doInstall()
  // @see https://www.drupal.org/project/drupal/issues/3425992
  \Drupal::configFactory()->getEditable('canvas_ai.settings')
    ->set('main_agent', 'canvas_agent')
    ->set('tools', ['canvas_component_agent', 'drupal_canvas_page_agent'])
    ->save();
}

/**
 * Install the Canvas AI Legacy module.
 */
function canvas_ai_update_11200(): void {
  \Drupal::service(ModuleInstallerInterface::class)->install(['canvas_ai_legacy']);
}

<?php

declare(strict_types=1);

use Drupal\canvas\AutoSave\AutoSaveManager;
use Drupal\canvas\AutoSave\Workspace\AutoSaveWorkspace;
use Drupal\canvas\AutoSave\Workspace\CanvasWorkspaceProvider;
use Drupal\canvas\CanvasNotificationHandler;
use Drupal\canvas\Entity\CanvasAutoSaveSnapshot;
use Drupal\canvas\Health\HealthCheck;
use Drupal\canvas\Health\HealthRecords;
use Drupal\Core\Datetime\DateFormatterInterface;
use Drupal\Core\Extension\Requirement\RequirementSeverity;
use Drupal\Core\Extension\ThemeHandlerInterface;
use Drupal\Core\Extension\ThemeInstallerInterface;
use Drupal\Core\StreamWrapper\StreamWrapperManagerInterface;

/**
 * Implements hook_install().
 */
function canvas_install(): void {
  _canvas_ensure_workspaces_module_enabled();
  _canvas_ensure_auto_save_workspace();
}

/**
 * Creates the Canvas-provided workspace when missing.
 *
 * The `provider` value keeps it out of the Workspaces UI listing and routes
 * all access decisions through CanvasWorkspaceProvider.
 *
 * @see \Drupal\canvas\AutoSave\Workspace\CanvasWorkspaceProvider
 */
function _canvas_ensure_auto_save_workspace(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('workspace');
  if ($storage->load(AutoSaveWorkspace::ID) !== NULL) {
    return;
  }
  $workspace = $storage->create([
    'id' => AutoSaveWorkspace::ID,
    'label' => AutoSaveWorkspace::LABEL,
    'uid' => 1,
    'provider' => CanvasWorkspaceProvider::getId(),
  ]);
  $workspace->save();
}

/**
 * Implements hook_module_preinstall().
 */
function canvas_module_preinstall(string $module): void {
  if ($module !== 'canvas') {
    return;
  }

  // Register the JSON schema definitions stream wrapper *prior* to installing
  // default config and hence prior to config validation. Otherwise validation
  // fails.
  // @see \Drupal\canvas\JsonSchemaDefinitionsStreamwrapper
  // @see \Drupal\Core\Extension\ModuleInstaller::install()
  // @todo Remove this after https://www.drupal.org/project/drupal/issues/3352063 lands.
  \Drupal::service(StreamWrapperManagerInterface::class)->register();
}

/**
 * Implements hook_module_preuninstall().
 */
function canvas_module_preuninstall(string $module, bool $is_syncing): void {
  if ($module !== 'canvas') {
    return;
  }

  \Drupal::service(AutoSaveManager::class)->deleteAll();
}

/**
 * Implements hook_uninstall().
 */
function canvas_uninstall(bool $is_syncing): void {
  $schema = \Drupal::database()->schema();
  $tables = [
    CanvasNotificationHandler::NOTIFICATION_TABLE,
    CanvasNotificationHandler::NOTIFICATION_READ_TABLE,
    HealthRecords::TABLE,
  ];
  foreach ($tables as $table) {
    if ($schema->tableExists($table)) {
      $schema->dropTable($table);
    }
  }
}

/**
 * Implements hook_requirements().
 *
 * @todo Remove when https://www.drupal.org/project/drupal/issues/3472008 is fixed in Drupal core.
 */
function canvas_requirements(string $phase): array {
  $requirements = [];
  if ($phase === 'install' || $phase == 'runtime') {
    $canvas_stark_enabled = \Drupal::service(ThemeHandlerInterface::class)->themeExists('canvas_stark');
    if (!$canvas_stark_enabled) {
      $requirements['canvas_stark'] = [
        'title' => t('Drupal Canvas Theme'),
        'description' => t('The required theme <code>canvas_stark</code> is no longer installed due to manually modified changes to <code>core.extension</code>. The Drupal Canvas user interface will be broken without this theme. You can install it by running <code>drush theme:install canvas_stark</code>.'),
        'severity' => RequirementSeverity::Warning,
      ];
    }

    // Check if JSON:API module is enabled.
    $json_api_enabled = \Drupal::moduleHandler()->moduleExists('jsonapi');
    if ($json_api_enabled) {
      $severity = RequirementSeverity::Warning;
      // Check if PHP assertions are enabled and update the severity.
      // @see \Drupal\canvas\EventSubscriber\ApiMessageValidator::isProd()
      $assertions_disabled = TRUE;
      // @phpstan-ignore-next-line booleanNot.alwaysTrue
      assert(!($assertions_disabled = FALSE));
      // @phpstan-ignore-next-line booleanNot.alwaysTrue function.alreadyNarrowedType
      if (!$assertions_disabled) {
        $severity = RequirementSeverity::Error;
      }
      $requirements['canvas'] = [
        'title' => t('Drupal Canvas'),
        'description' => t("Drupal Canvas requires the <code>justinrainbow/json-schema</code> library which may impact site performance when the JSON:API module is installed and PHP assertions are enabled. See <a href=':url'>:url</a> for more information.", [':url' => 'https://www.drupal.org/project/drupal/issues/3472008']),
        'severity' => $severity,
      ];
    }
  }
  if ($phase === 'runtime') {
    $requirements['canvas_data_health'] = _canvas_data_health_requirement();
  }
  return $requirements;
}

/**
 * Builds the 'canvas_data_health' entry for hook_requirements().
 *
 * @return array
 *   A single hook_requirements() entry.
 */
function _canvas_data_health_requirement(): array {
  // Risk-kind checks (auto-save) are excluded: drafts are allowed to be
  // invalid, so they must not surface as invalid site data here.
  $health_checks = \array_filter(HealthCheck::dataChecks(), static fn (HealthCheck $check): bool => !$check->findingsAreRisks());
  $summary = \Drupal::service(HealthRecords::class)->getSummary(\array_values($health_checks));

  $requirement = ['title' => t('Drupal Canvas data health')];

  if ($summary['total_items'] === 0) {
    $requirement['value'] = t('Not yet checked');
    $requirement['description'] = t('Canvas has not checked any data yet. It is checked incrementally on cron, or run <code>vendor/bin/dr canvas:doctor --all-checks</code> to check everything immediately.');
    $requirement['severity'] = RequirementSeverity::Info;
    return $requirement;
  }

  if ($summary['problem_items'] > 0) {
    $requirement['value'] = t('@n of @t checked data item(s) invalid', [
      '@n' => $summary['problem_items'],
      '@t' => $summary['total_items'],
    ]);
    $requirement['description'] = $summary['last_checked_at'] !== NULL
      ? t('As of @date. Run <code>vendor/bin/dr canvas:doctor --all-checks --details</code> for more information.', ['@date' => \Drupal::service(DateFormatterInterface::class)->format($summary['last_checked_at'])])
      : t('Run <code>vendor/bin/dr canvas:doctor --all-checks --details</code> for more information.');
    $requirement['severity'] = RequirementSeverity::Warning;
    return $requirement;
  }

  $requirement['value'] = t('All @t checked data items valid', ['@t' => $summary['total_items']]);
  $requirement['description'] = $summary['last_checked_at'] !== NULL
    ? t('As of @date.', ['@date' => \Drupal::service(DateFormatterInterface::class)->format($summary['last_checked_at'])])
    : '';
  $requirement['severity'] = RequirementSeverity::OK;
  return $requirement;
}

/**
 * Install `canvas_stark` theme if not enabled.
 */
function canvas_update_11200(): void {
  /** @var \Drupal\Core\Extension\ThemeHandlerInterface $theme_handler */
  $theme_handler = \Drupal::service(ThemeHandlerInterface::class);
  if (!$theme_handler->themeExists('canvas_stark')) {
    // Ensure canvas_stark is installed.
    // For that to happen when installing canvas with a recipe, we cannot do it
    // conditionally based on the `$is_syncing` flag.
    // @see \Drupal\canvas\Theme\CanvasThemeNegotiator
    // @see \Drupal\Core\Theme\ThemeNegotiator::determineActiveTheme()
    \Drupal::service(ThemeInstallerInterface::class)->install(['canvas_stark']);

    // No need to manually flush caches during the update.
    // @see \Drupal\system\Controller\DbUpdateController::triggerBatch()
  }
}

/**
 * Workspaces auto-save: entity schema, Workspaces module, shared workspace.
 *
 * Idempotent: installs canvas_auto_save_snapshot when missing, enables the
 * Workspaces module if needed, creates the canvas_default workspace entity.
 */
function canvas_update_11201(): void {
  /** @var \Drupal\Core\Entity\EntityLastInstalledSchemaRepositoryInterface $repository */
  $repository = \Drupal::service('entity.last_installed_schema.repository');
  if ($repository->getLastInstalledDefinition(CanvasAutoSaveSnapshot::ENTITY_TYPE_ID) === NULL) {
    $definition = \Drupal::entityTypeManager()->getDefinition(CanvasAutoSaveSnapshot::ENTITY_TYPE_ID);
    \Drupal::entityDefinitionUpdateManager()->installEntityType($definition);
  }

  _canvas_ensure_workspaces_module_enabled();
  _canvas_ensure_auto_save_workspace();
}

/**
 * Enables the Workspaces module when missing.
 *
 * Canvas declares Workspaces as a dependency; extensions listed in
 * core.extension may omit it on older sites until this runs.
 */
function _canvas_ensure_workspaces_module_enabled(): void {
  if (\Drupal::moduleHandler()->moduleExists('workspaces')) {
    return;
  }
  /** @var \Drupal\Core\Extension\ModuleInstallerInterface $installer */
  $installer = \Drupal::service('module_installer');
  $installer->install(['workspaces']);
}

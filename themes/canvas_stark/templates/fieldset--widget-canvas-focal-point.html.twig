{#
/**
 * @file
 * Canvas Stark override for the focal point widget's fieldset.
 *
 * Renders the x and y inputs inside a focal point picker. Inside a multivalue
 * table, renders a list row that opens the picker in a popover instead. When
 * the component has an image prop, the React components render their control
 * under that image's media widget.
 *
 * Available variables: see fieldset.html.twig.
 *
 * @see \Drupal\canvas\Plugin\Field\FieldWidget\CanvasFocalPointWidget
 * @see \Drupal\canvas\Hook\ReduxIntegratedFieldWidgetsHooks::fieldWidgetCompleteFormAlter()
 *
 * @ingroup themeable
 */
#}
{% if element['#multivalue_field_label'] is not empty %}
  <drupal-canvas-focal-point--multivalue-form
    field-label="{{ element['#multivalue_field_label'] }}"
    image-prop="{{ attributes['data-canvas-focal-point-image'] }}"
  >
    {{ children }}
  </drupal-canvas-focal-point--multivalue-form>
{% else %}
  {%
    set classes = [
      'js-form-item',
      'form-item',
      'js-form-wrapper',
      'form-wrapper',
    ]
  %}
  {#
    A labelled group rather than a <fieldset>, to match other widgets. With an
    image prop, the widget renders its control under that image, so the group
    itself is hidden.
  #}
  {% if attributes['data-canvas-focal-point-image'] is not empty %}
    {% set attributes = attributes.setAttribute('hidden', 'hidden') %}
  {% endif %}
  <div{{ attributes.addClass(classes).setAttribute('role', 'group').setAttribute('aria-label', legend.title|render|striptags|trim) }}>
    <canvas-drupal-label
      title="{{ legend.title }}"
      required="{{ required }}"
      {% if prop_link_data %}
        direct_linker_data="{{ prop_link_data }}"
      {% endif %}
    >
    </canvas-drupal-label>
    {% if errors %}
      <div>
        {{ errors }}
      </div>
    {% endif %}
    <drupal-canvas-focal-point
      image-prop="{{ attributes['data-canvas-focal-point-image'] }}"
    >
      {{ children }}
    </drupal-canvas-focal-point>
    {% if description.content %}
      <canvas-description{{ description.attributes.addClass('description') }} description="{{ description.content|render|e('html_attr') }}" />
    {% endif %}
  </div>
{% endif %}

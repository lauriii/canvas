{
  "name": "@drupal-canvas/headless-react",
  "version": "0.4.0",
  "engines": {
    "node": ">=22.19.0 <23 || >=24.5.0"
  },
  "description": "Shared React bindings for the Drupal Canvas Headless SDK.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://git.drupalcode.org/project/canvas.git",
    "directory": "packages/headless-react"
  },
  "bugs": "https://git.drupalcode.org/project/canvas/-/work_items",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "NODE_ENV=development tsdown --watch",
    "build": "npm run type-check && NODE_ENV=production tsdown",
    "test": "vitest run",
    "type-check": "tsc --noEmit --pretty"
  },
  "dependencies": {
    "@drupal-canvas/headless": "^0.6.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^26.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsdown": "^0.22.12",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}

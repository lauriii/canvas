{
  "name": "@drupal-canvas/headless-next",
  "version": "0.0.3",
  "description": "Next.js adapter for the Drupal Canvas Headless SDK.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://git.drupalcode.org/project/canvas.git",
    "directory": "packages/headless-next"
  },
  "bugs": "https://git.drupalcode.org/project/canvas/-/work_items",
  "files": [
    "src",
    "!src/**/*.test.*",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "import": "./src/client/index.ts",
      "types": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    },
    "./config": {
      "import": "./src/config/index.ts",
      "types": "./src/config/index.ts",
      "default": "./src/config/index.ts"
    },
    "./CanvasComponentTree": {
      "import": "./src/canvas-component-tree.tsx",
      "types": "./src/canvas-component-tree.tsx",
      "default": "./src/canvas-component-tree.tsx"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit --pretty"
  },
  "dependencies": {
    "@drupal-canvas/headless": "^0.1.1",
    "@drupal-canvas/headless-react": "^0.1.1"
  },
  "peerDependencies": {
    "next": ">=15.0.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "next": "^16.2.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3"
  }
}

{
  "name": "@drupal-canvas/headless-next",
  "version": "0.1.0",
  "description": "Next.js adapter for the Drupal Canvas Headless SDK: Draft Mode and cookie adapter, draft route handlers, the component metadata endpoint, the withCanvas() config wrapper, and the <DraftSession> client component.",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "import": "./src/client/index.ts",
      "types": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    },
    "./config": {
      "import": "./src/config/index.ts",
      "types": "./src/config/index.ts",
      "default": "./src/config/index.ts"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit --pretty"
  },
  "license": "GPL-2.0-or-later",
  "dependencies": {
    "@drupal-canvas/headless": "*",
    "@drupal-canvas/headless-react": "*"
  },
  "peerDependencies": {
    "next": ">=15.0.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "next": "16.2.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3"
  },
  "sideEffects": false
}

{
  "name": "@drupal-canvas/headless-next",
  "version": "0.7.0",
  "engines": {
    "node": ">=22.19.0 <23 || >=24.5.0"
  },
  "description": "Next.js adapter for the Drupal Canvas Headless SDK.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://git.drupalcode.org/project/canvas.git",
    "directory": "packages/headless-next"
  },
  "bugs": "https://git.drupalcode.org/project/canvas/-/work_items",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js",
      "default": "./dist/middleware.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js",
      "default": "./dist/config/index.js"
    },
    "./CanvasComponentTree": {
      "types": "./dist/canvas-component-tree.d.ts",
      "import": "./dist/canvas-component-tree.js",
      "default": "./dist/canvas-component-tree.js"
    },
    "./ComponentPreviewPage": {
      "types": "./dist/component-preview-page.d.ts",
      "import": "./dist/component-preview-page.js",
      "default": "./dist/component-preview-page.js"
    },
    "./CanvasRuntime": {
      "types": "./dist/canvas-runtime.d.ts",
      "import": "./dist/canvas-runtime.js",
      "default": "./dist/canvas-runtime.js"
    }
  },
  "scripts": {
    "dev": "NODE_ENV=development tsdown --watch",
    "build": "npm run type-check && NODE_ENV=production tsdown",
    "test": "vitest run",
    "type-check": "tsc --noEmit --pretty"
  },
  "dependencies": {
    "@drupal-canvas/headless": "^0.10.0",
    "@drupal-canvas/headless-react": "^0.5.0",
    "drupal-canvas": "^0.7.0"
  },
  "peerDependencies": {
    "next": ">=15.0.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "next": "^16.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsdown": "^0.22.12",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}

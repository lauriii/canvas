{
  "name": "@drupal-canvas/json-render-astro",
  "version": "0.2.0",
  "engines": {
    "node": ">=22.19.0 <23 || >=24.5.0"
  },
  "description": "Astro renderer for Drupal Canvas json-render documents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://git.drupalcode.org/project/canvas.git",
    "directory": "packages/json-render-astro"
  },
  "bugs": "https://git.drupalcode.org/project/canvas/-/work_items",
  "files": [
    "src",
    "!src/**/*.test.*",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./CanvasComponentTree.astro": "./src/CanvasComponentTree.astro"
  },
  "scripts": {
    "test": "vitest run",
    "type-check": "astro check --tsconfig ./tsconfig.json && tsc --noEmit --pretty"
  },
  "dependencies": {
    "@drupal-canvas/json-render": "^0.2.0"
  },
  "peerDependencies": {
    "astro": ">=5.17.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "astro": "^7.3.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}

---
import {
  CANVAS_EMPTY_REGION_PLACEHOLDER_CLASS,
  formatCanvasCommentMarker,
  areCanvasComponentTreeChildrenEmpty,
  CANVAS_MARKER_ELEMENT,
  CANVAS_PREVIEW_CONTENT_REGION_ELEMENT,
  CANVAS_SLOT_PLACEHOLDER_ELEMENT,
  findCanvasComponent,
  getCanvasComponentTreeElementSlots,
  getJsonRenderComponentData,
  reportMissingCanvasComponent,
  reportMissingCanvasComponentUuid,
  reportMissingCanvasMarkerComponentUuid,
} from '@drupal-canvas/json-render/renderer';
import {
  render as renderTemplate,
  renderComponent,
} from 'astro/runtime/server/index.js';
import CanvasSlot from './CanvasSlot.astro';

import type {
  AstroComponentFactory,
  ComponentSlots,
} from 'astro/runtime/server/index.js';
import type { CanvasComponentTree } from '@drupal-canvas/json-render';
import type { CanvasComponentRegistry } from './types';

interface Props {
  tree: CanvasComponentTree;
  elementKey: string;
  components: CanvasComponentRegistry;
  path: string;
  editor: boolean;
}

const { tree, elementKey, components, path, editor } = Astro.props;
const node = tree.elements[elementKey];
const componentData = node
  ? getJsonRenderComponentData(node, components, elementKey)
  : null;
const Component = componentData
  ? findCanvasComponent(components, componentData)
  : undefined;
const slots = node ? getCanvasComponentTreeElementSlots(node) : [];

if (componentData && !Component) {
  reportMissingCanvasComponent(componentData, path);
}
if (editor && componentData && !componentData.componentUuid) {
  reportMissingCanvasComponentUuid(componentData, path);
}

// Astro's template syntax compiles named slots statically. Canvas slot names
// arrive at runtime, so construct the slot map through Astro's server renderer.
const RuntimeComponent: AstroComponentFactory = (result) => {
  const runtimeSlots: ComponentSlots = Object.fromEntries(
    slots.map(([name, childKeys]) => [
      name,
      (slotResult) =>
        renderTemplate`${renderComponent(
          slotResult,
          'CanvasSlot',
          CanvasSlot,
          {
            tree,
            name,
            childKeys,
            components,
            path,
            editor,
            componentUuid: componentData?.componentUuid,
          },
        )}`,
    ]),
  );

  return renderTemplate`${renderComponent(
    result,
    componentData?.componentName ?? 'CanvasComponent',
    Component,
    componentData?.props ?? {},
    runtimeSlots,
  )}`;
};
RuntimeComponent.isAstroComponentFactory = true;

const regionEmpty =
  node?.type === CANVAS_PREVIEW_CONTENT_REGION_ELEMENT &&
  areCanvasComponentTreeChildrenEmpty(
    tree,
    slots.flatMap(([, childKeys]) => childKeys),
  );
const markup = node?.type === 'drupal-markup' ? node.props.markup : undefined;
const slotPlaceholder = node?.type === CANVAS_SLOT_PLACEHOLDER_ELEMENT;
const canvasMarker = node?.type === CANVAS_MARKER_ELEMENT;
const markerComponentUuid = canvasMarker ? elementKey : undefined;
if (editor && canvasMarker && !markerComponentUuid) {
  reportMissingCanvasMarkerComponentUuid(path);
}
---

{
  slotPlaceholder ? null : node?.type === CANVAS_PREVIEW_CONTENT_REGION_ELEMENT ? (
    <>
      {editor && (
        <Fragment
          set:html={`<!-- ${formatCanvasCommentMarker({ type: 'region', position: 'start', id: 'content' })} -->`}
        />
      )}
      {editor && regionEmpty && (
        <div
          aria-hidden="true"
          class={CANVAS_EMPTY_REGION_PLACEHOLDER_CLASS}
        />
      )}
      {slots.map(([name, childKeys]) =>
        childKeys.map((childKey, index) => (
          <Astro.self
            tree={tree}
            elementKey={childKey}
            components={components}
            path={`${path}:${name}:${index}`}
            editor={editor}
          />
        )),
      )}
      {editor && (
        <Fragment
          set:html={`<!-- ${formatCanvasCommentMarker({ type: 'region', position: 'end', id: 'content' })} -->`}
        />
      )}
    </>
  ) : canvasMarker ? (
    <>
      {editor && markerComponentUuid && (
        <Fragment
          set:html={`<!-- ${formatCanvasCommentMarker({ type: 'component', position: 'start', id: markerComponentUuid })} -->`}
        />
      )}
      {slots.map(([name, childKeys]) =>
        childKeys.map((childKey, index) => (
          <Astro.self
            tree={tree}
            elementKey={childKey}
            components={components}
            path={`${path}:${name}:${index}`}
            editor={editor}
          />
        )),
      )}
      {editor && markerComponentUuid && (
        <Fragment
          set:html={`<!-- ${formatCanvasCommentMarker({ type: 'component', position: 'end', id: markerComponentUuid })} -->`}
        />
      )}
    </>
  ) : node?.type === 'drupal-markup' ? (
    typeof markup === 'string' ? (
      <Fragment set:html={markup} />
    ) : null
  ) : node && !componentData ? (
    slots.map(([name, childKeys]) =>
      childKeys.map((childKey, index) => (
        <Astro.self
          tree={tree}
          elementKey={childKey}
          components={components}
          path={`${path}:${name}:${index}`}
          editor={editor}
        />
      )),
    )
  ) : Component ? (
    <>
      {editor && componentData?.componentUuid && (
        <Fragment
          set:html={`<!-- ${formatCanvasCommentMarker({ type: 'component', position: 'start', id: componentData.componentUuid })} -->`}
        />
      )}
      <RuntimeComponent />
      {editor && componentData?.componentUuid && (
        <Fragment
          set:html={`<!-- ${formatCanvasCommentMarker({ type: 'component', position: 'end', id: componentData.componentUuid })} -->`}
        />
      )}
    </>
  ) : null
}

{
  "name": "@drupal-canvas/headless-angular",
  "version": "0.2.2",
  "description": "Angular rendering bindings for Drupal Canvas Headless.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "canvas-angular": "./tools/build.mjs"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "engines": {
    "node": ">=22.19.0 <23 || >=24.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://git.drupalcode.org/project/canvas.git",
    "directory": "packages/headless-angular"
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.json",
    "type-check": "ngc -p tsconfig.json --noEmit",
    "test": "vitest run tests"
  },
  "peerDependencies": {
    "@angular/common": "^21.0.0 || ^22.0.0",
    "@angular/core": "^21.0.0 || ^22.0.0",
    "@angular/platform-browser": "^21.0.0 || ^22.0.0",
    "@angular/router": "^21.0.0 || ^22.0.0"
  },
  "dependencies": {
    "@drupal-canvas/headless": "^0.10.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/common": "21.2.23",
    "@angular/compiler": "21.2.23",
    "@angular/compiler-cli": "21.2.23",
    "@angular/core": "21.2.23",
    "@angular/platform-browser": "21.2.23",
    "@angular/router": "21.2.23",
    "ng-packagr": "21.2.7",
    "typescript": "5.9.3"
  }
}

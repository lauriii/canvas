{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "paths": { "@drupal-canvas/headless-angular/contracts": ["./contracts/index.ts"] },
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "declaration": true
  },
  "angularCompilerOptions": {
    "compilationMode": "partial",
    "strictTemplates": true,
    "strictInjectionParameters": true
  },
  "include": ["src/**/*.ts", "contracts/**/*.ts", "server/**/*.ts"]
}

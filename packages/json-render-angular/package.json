{
  "name": "@drupal-canvas/json-render-angular",
  "version": "0.1.0",
  "description": "Angular renderer for Drupal Canvas json-render documents.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "engines": {
    "node": ">=22.19.0 <23 || >=24.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://git.drupalcode.org/project/canvas.git",
    "directory": "packages/json-render-angular"
  },
  "bugs": {
    "url": "https://git.drupalcode.org/project/canvas/-/work_items"
  },
  "exports": {
    ".": {
      "types": "./dist/types/drupal-canvas-json-render-angular.d.ts",
      "default": "./dist/fesm2022/drupal-canvas-json-render-angular.mjs"
    }
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.json",
    "type-check": "ngc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@angular/common": "^21.0.0 || ^22.0.0",
    "@angular/core": "^21.0.0 || ^22.0.0",
    "@angular/platform-browser": "^21.0.0 || ^22.0.0"
  },
  "dependencies": {
    "@drupal-canvas/json-render": "^0.1.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/common": "21.2.24",
    "@angular/compiler": "21.2.24",
    "@angular/compiler-cli": "21.2.24",
    "@angular/core": "21.2.24",
    "@angular/platform-browser": "21.2.24",
    "ng-packagr": "21.2.7",
    "typescript": "5.9.3",
    "jsdom": "^26.1.0",
    "vitest": "^4.0.18"
  }
}

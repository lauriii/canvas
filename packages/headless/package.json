{
  "name": "@drupal-canvas/headless",
  "version": "0.4.0",
  "engines": {
    "node": ">=22.19.0 <23 || >=24.5.0"
  },
  "description": "Framework-agnostic core of the Drupal Canvas Headless SDK: draft preview sessions, draft-aware content clients, and component metadata exposure for decoupled frontend apps.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://git.drupalcode.org/project/canvas.git",
    "directory": "packages/headless"
  },
  "bugs": "https://git.drupalcode.org/project/canvas/-/work_items",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "./dist/preview.css"
  ],
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./components-endpoint": {
      "types": "./dist/components-endpoint/index.d.ts",
      "import": "./dist/components-endpoint/index.js",
      "default": "./dist/components-endpoint/index.js"
    },
    "./components-endpoint/handler": {
      "types": "./dist/components-endpoint/handler.d.ts",
      "import": "./dist/components-endpoint/handler.js",
      "default": "./dist/components-endpoint/handler.js"
    },
    "./component-registry": {
      "types": "./dist/component-registry.d.ts",
      "import": "./dist/component-registry.js",
      "default": "./dist/component-registry.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./preview.css": "./dist/preview.css"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsdown --watch",
    "build": "npm run type-check && NODE_ENV=production tsdown",
    "test": "vitest run",
    "type-check": "tsc --noEmit --pretty"
  },
  "dependencies": {
    "@drupal-api-client/json-api-client": "^1.4.1"
  },
  "devDependencies": {
    "@drupal-canvas/discovery": "*",
    "@drupal-canvas/height-reader": "*",
    "@drupal-canvas/preview-geometry": "*",
    "@types/node": "^24.10.1",
    "jsdom": "^26.1.0",
    "tsdown": "^0.22.12",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}

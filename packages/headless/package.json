{
  "name": "@drupal-canvas/headless",
  "version": "0.1.0",
  "description": "Framework-agnostic core of the Drupal Canvas Headless SDK: draft preview sessions bound to the editing user, in-place session renewal inside the Canvas editor frame, draft-aware content clients, and the component metadata endpoint Drupal Canvas registers an app's components from.",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "import": "./src/client/index.ts",
      "types": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    },
    "./server": {
      "import": "./src/server/index.ts",
      "types": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    },
    "./components-endpoint": {
      "import": "./src/components-endpoint/index.ts",
      "types": "./src/components-endpoint/index.ts",
      "default": "./src/components-endpoint/index.ts"
    },
    "./components-endpoint/handler": {
      "import": "./src/components-endpoint/handler.ts",
      "types": "./src/components-endpoint/handler.ts",
      "default": "./src/components-endpoint/handler.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "type-check": "tsc --noEmit --pretty"
  },
  "license": "GPL-2.0-or-later",
  "dependencies": {
    "@drupal-api-client/json-api-client": "^1.4.1",
    "@drupal-canvas/discovery": "*"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "sideEffects": false
}

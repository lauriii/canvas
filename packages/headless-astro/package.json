{
  "name": "@drupal-canvas/headless-astro",
  "version": "0.3.0",
  "engines": {
    "node": ">=22.19.0 <23 || >=24.5.0"
  },
  "description": "Astro adapter for the Drupal Canvas Headless SDK.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://git.drupalcode.org/project/canvas.git",
    "directory": "packages/headless-astro"
  },
  "bugs": "https://git.drupalcode.org/project/canvas/-/work_items",
  "files": [
    "src",
    "!src/**/*.test.*",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./integration": {
      "import": "./src/integration.ts",
      "types": "./src/integration.ts",
      "default": "./src/integration.ts"
    },
    "./middleware": {
      "import": "./src/middleware.ts",
      "types": "./src/middleware.ts",
      "default": "./src/middleware.ts"
    },
    "./routes/draft": {
      "import": "./src/routes/draft.ts",
      "types": "./src/routes/draft.ts",
      "default": "./src/routes/draft.ts"
    },
    "./routes/draft-renew": {
      "import": "./src/routes/draft-renew.ts",
      "types": "./src/routes/draft-renew.ts",
      "default": "./src/routes/draft-renew.ts"
    },
    "./routes/disable-draft": {
      "import": "./src/routes/disable-draft.ts",
      "types": "./src/routes/disable-draft.ts",
      "default": "./src/routes/disable-draft.ts"
    },
    "./routes/components": {
      "import": "./src/routes/components.ts",
      "types": "./src/routes/components.ts",
      "default": "./src/routes/components.ts"
    },
    "./DraftSession.astro": "./src/components/DraftSession.astro",
    "./CanvasComponentTree.astro": "./src/components/CanvasComponentTree.astro",
    "./ComponentPreviewPage.astro": "./src/components/ComponentPreviewPage.astro"
  },
  "scripts": {
    "test": "vitest run",
    "type-check": "astro check --tsconfig ./tsconfig.json && tsc --noEmit --pretty"
  },
  "dependencies": {
    "@drupal-canvas/headless": "^0.4.0"
  },
  "peerDependencies": {
    "astro": ">=5.17.0",
    "vite": ">=6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "astro": "^7.0.7",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^4.0.18"
  }
}

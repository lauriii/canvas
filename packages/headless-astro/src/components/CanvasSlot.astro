---
import CanvasElement from './CanvasElement.astro';
import {
  CANVAS_EMPTY_SLOT_PLACEHOLDER_CLASS,
  formatCanvasCommentMarker,
  isCanvasComponentTreeSlotEmpty,
} from '@drupal-canvas/headless';

import type { CanvasComponentTreeElement } from '@drupal-canvas/headless/server';

interface Props {
  name: string;
  children: Array<string | CanvasComponentTreeElement>;
  components: Record<string, unknown>;
  path: string;
  editor: boolean;
  componentUuid?: string;
}

const { name, children, components, path, editor, componentUuid } = Astro.props;
const slotId = componentUuid ? `${componentUuid}/${name}` : null;
const empty = isCanvasComponentTreeSlotEmpty(children);
---

{
  editor && slotId && (
    <Fragment
      set:html={`<!-- ${formatCanvasCommentMarker({ type: 'slot', position: 'start', id: slotId })} -->`}
    />
  )
}
{
  editor && slotId && empty && (
    <div
      aria-hidden="true"
      class={CANVAS_EMPTY_SLOT_PLACEHOLDER_CLASS}
    />
  )
}
{
  (!editor || !empty) &&
    children.map((child, index) =>
      typeof child === 'string' ? (
        <Fragment set:html={child} />
      ) : (
        <CanvasElement
          node={child}
          components={components}
          path={`${path}:${name}:${index}`}
          editor={editor}
        />
      ),
    )
}
{
  editor && slotId && (
    <Fragment
      set:html={`<!-- ${formatCanvasCommentMarker({ type: 'slot', position: 'end', id: slotId })} -->`}
    />
  )
}

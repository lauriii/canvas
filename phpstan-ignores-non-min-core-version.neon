parameters:
	ignoreErrors:
		-
			message: '#^Method Drupal\\Core\\Asset\\AssetResolver\:\:getJsAssets\(\) invoked with 4 parameters, 2\-3 required\.$#'
			identifier: arguments.count
			count: 1
			path: src/Asset/AssetResolver.php

		-
			message: '#^Method Drupal\\Core\\Asset\\AssetResolverInterface\:\:getJsAssets\(\) invoked with 4 parameters, 2\-3 required\.$#'
			identifier: arguments.count
			count: 1
			path: src/Asset/AssetResolver.php

		-
			message: '#^Method Drupal\\Component\\Plugin\\CategorizingPluginManagerInterface\:\:getGroupedDefinitions\(\) invoked with 2 parameters, 0\-1 required\.$#'
			identifier: arguments.count
			count: 1
			path: src/Block/BlockManagerDecorator.php

		-
			message: '#^Method Drupal\\Component\\Plugin\\CategorizingPluginManagerInterface\:\:getSortedDefinitions\(\) invoked with 2 parameters, 0\-1 required\.$#'
			identifier: arguments.count
			count: 1
			path: src/Block/BlockManagerDecorator.php

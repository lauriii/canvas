<?php

declare(strict_types=1);

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Session\AccountInterface;

/**
 * Implements hook_ENTITY_TYPE_access().
 *
 * Denies view access to canvas_page entity with id 1.
 */
function canvas_test_access_canvas_page_access(EntityInterface $entity, string $operation, AccountInterface $account): AccessResultInterface {
  $cacheContexts = \Drupal::keyValue('canvas_test_access')->get('cache_contexts', []);
  $cacheTags = \Drupal::keyValue('canvas_test_access')->get('cache_tags', []);

  if ((int) $entity->id() === 1 && $operation === 'view') {
    return AccessResult::forbidden();
  }
  if ((int) $entity->id() === 1 && $operation === 'update' && !empty($cacheTags) && !empty($cacheContexts)) {
    return AccessResult::allowed()->addCacheContexts($cacheContexts)->addCacheTags($cacheTags);
  }

  return AccessResult::neutral();
}

/**
 * Implements hook_ENTITY_TYPE_access() for media.
 *
 * Denies view access to the media entities whose IDs a test stored in the
 * `canvas_test_access` key-value collection under `deny_view_media_ids`.
 * This lets tests make per-entity access stricter than entity query access.
 */
function canvas_test_access_media_access(EntityInterface $entity, string $operation, AccountInterface $account): AccessResultInterface {
  $denied_ids = \Drupal::keyValue('canvas_test_access')->get('deny_view_media_ids', []);
  if ($operation === 'view' && \in_array((int) $entity->id(), $denied_ids, TRUE)) {
    return AccessResult::forbidden('Denied by the canvas_test_access test module.');
  }
  return AccessResult::neutral();
}

{#
  Renders date and date-time props through the canvasFormatDate and
  canvasFormatDateTime Twig filters to verify that the filters produce
  locale-formatted output rather than the raw ISO strings that Canvas passes
  to templates by default. The formatted values are not wrapped in |default('')
  because the filters accept NULL and return an empty string for it.
#}
<dl>
  <dt>date (raw)</dt>
  <dd id="date-raw">{{ date|default('') }}</dd>
  <dt>date (formatted)</dt>
  <dd id="date-formatted-date">{{ date|canvasFormatDate }}</dd>

  <dt>date_time (raw)</dt>
  <dd id="date-time-raw">{{ date_time|default('') }}</dd>
  <dt>date_time (formatted)</dt>
  <dd id="date-formatted-date-time">{{ date_time|canvasFormatDateTime }}</dd>
</dl>

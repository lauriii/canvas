<div class="untranslatable-prop-shapes">
  <p class="untranslatable-prop-shapes__date">{{ date|default('') }}</p>
  <p class="untranslatable-prop-shapes__email">{{ email|default('') }}</p>
  <p class="untranslatable-prop-shapes__count">{{ count|default('') }}</p>
  <p class="untranslatable-prop-shapes__flag">{{ flag ? 'yes' : 'no' }}</p>
</div>

{
  "name": "@drupal/experience_builder-cli",
  "version": "0.0.0",
  "description": "CLI tool for managing Experience Builder components",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prettier:fix": "prettier . --write --config ../.prettierrc.json",
    "prettier:check": "prettier . --check --config ../.prettierrc.json",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint": "npm run lint:eslint",
    "lint:fix": "eslint --fix .",
    "type-check": "tsc --noEmit --pretty"
  },
  "keywords": [
    "experience-builder",
    "drupal",
    "cli"
  ],
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@eslint/js": "^9.22.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "globals": "^16.0.0",
    "prettier": "^3.2.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
}
